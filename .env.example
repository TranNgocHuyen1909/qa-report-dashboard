# Cổng public của Docker Compose
APP_PORT=8080

# Cổng API khi chạy local (Docker Compose luôn dùng 8788 trong container)
PORT=8788

# Notion
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_BUG_DATA_SOURCE_ID=

# GitHub personal access token dùng để đọc dữ liệu PR và comment
GITHUB_TOKEN=

# Chu kỳ đồng bộ dữ liệu, tính bằng giây
REFRESH_INTERVAL_SECONDS=300

# Đường dẫn lưu checklist khi chạy local
CHECKLIST_PATH=.cache/checklist.json
