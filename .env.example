# Cổng public của Docker Compose
APP_PORT=8080

# Cổng API khi chạy local (Docker Compose luôn dùng 8788 trong container)
PORT=8788

# Notion
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
NOTION_BUG_DATA_SOURCE_ID=

# GitHub personal access token dùng để đọc dữ liệu PR và comment
GITHUB_TOKEN=

# Chu kỳ đồng bộ dữ liệu, tính bằng giây (30 phút = 1800s)
REFRESH_INTERVAL_SECONDS=1800

# Đường dẫn lưu checklist khi chạy local
CHECKLIST_PATH=.cache/checklist.json

# Cấu hình Tự Động FTP Deploy lên Server (AZDIGI Host / cPanel)
FTP_HOST=pbv-epyc-24929.azdigihost.com
FTP_USER=huyen@bugreport.anai.io.vn
FTP_PASSWORD=your_ftp_password_here
FTP_REMOTE_DIR=/

